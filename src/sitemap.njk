---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex %}
  <url>
    <loc>{{ site.url }}{{ p.url | replace("index.html", "") }}</loc>
    {%- if p.data.updated %}
    <lastmod>{{ p.data.updated | isoDate }}</lastmod>
    {%- endif %}
  </url>
{%- endif %}{% endfor %}
</urlset>
